SIMULATION_MODE=true
ALLOW_PRODUCTION_WRITE=false
AGENTTEAMS_ENABLED=true
AGENTTEAMS_RUNTIME_MODE=remote_matrix
AGENTTEAMS_TEAM_NAME=energymesh-park-control
AGENTTEAMS_TEAM_ROOM_ID=
AGENTTEAMS_MATRIX_BASE_URL=http://127.0.0.1:18080
AGENTTEAMS_MATRIX_ACCESS_TOKEN=
AGENTTEAMS_MANAGER_USER_ID=@energymesh-team-leader:matrix-local.agentteams.io:18080
AGENTTEAMS_REMOTE_WORKERS=energymesh-team-leader,perception-worker,dispatch-worker,audit-worker,execution-worker
AGENTTEAMS_WORKER_USER_IDS=@energymesh-team-leader:matrix-local.agentteams.io:18080,@perception-worker:matrix-local.agentteams.io:18080,@dispatch-worker:matrix-local.agentteams.io:18080,@audit-worker:matrix-local.agentteams.io:18080,@execution-worker:matrix-local.agentteams.io:18080
# Optional: record a live agentscope-ai/AgentTeams Team or deployment identifier.
AGENTTEAMS_INSTANCE_ID=
AGENTTEAMS_LLM_PROVIDER=openai-compat
AGENTTEAMS_OPENAI_BASE_URL=https://api.deepseek.com/v1
AGENTTEAMS_DEFAULT_MODEL=deepseek-chat
AGENTTEAMS_LLM_API_KEY=
ENERGYMESH_DB_PATH=./var/energymesh.db
ENERGYMESH_EVIDENCE_DIR=./runs
ENERGYMESH_HOST=0.0.0.0
ENERGYMESH_PORT=8000
# Optional: route OpenAI-compatible model calls through a local proxy.
# Use http://127.0.0.1:7890 or socks5://127.0.0.1:7890 if your proxy supports it.
ENERGYMESH_MODEL_PROXY=
