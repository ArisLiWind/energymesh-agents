[Unit]
Description=EnergyMesh Web
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/energymesh-agents
EnvironmentFile=-/opt/energymesh-agents/.env
EnvironmentFile=-/opt/energymesh-agents/.env.agentteams.local
Environment=PYTHONPATH=/opt/energymesh-agents/src
Environment=SIMULATION_MODE=true
Environment=ALLOW_PRODUCTION_WRITE=false
ExecStart=/opt/energymesh-agents/.venv/bin/uvicorn energymesh.api:app --app-dir src --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
