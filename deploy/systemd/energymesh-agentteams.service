[Unit]
Description=EnergyMesh AgentTeams keepalive
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/energymesh
Environment=ENERGYMESH_ROOT=/opt/energymesh
Environment=AGENTTEAMS_DIR=/opt/AgentTeams
Environment=ENV_FILE=/opt/energymesh/.env.agentteams.local
Environment=KEEPALIVE_INTERVAL=120
ExecStart=/usr/bin/env bash /opt/energymesh/scripts/ecs_agentteams_keepalive.sh
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
