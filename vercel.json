{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "SIMULATION_MODE": "true",
    "ALLOW_PRODUCTION_WRITE": "false",
    "AGENTTEAMS_ENABLED": "true",
    "ENERGYMESH_DB_PATH": "/tmp/energymesh.db",
    "ENERGYMESH_EVIDENCE_DIR": "/tmp/energymesh-runs"
  }
}
