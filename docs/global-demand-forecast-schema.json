{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnergyMesh 全球电力需求预测分析数据模型",
  "description": "用于前端渲染全球发电量历史折线(实线)与未来20年预测趋势(虚线)的数据结构模板。支持节点点击缩放及多情景对比。",
  "version": "1.0.0-draft",

  "metadata": {
    "chartId": "global-electricity-demand-forecast",
    "title": "全球电力需求增长趋势 (2000–2045)",
    "subtitle": "基于IEA、Ember等机构历史数据及AI驱动的电力需求预测模型",
    "unit": "TWh",
    "dataSource": "IEA Electricity 2025, Ember Global Electricity Review, IEA World Energy Outlook 2025",
    "lastUpdated": "2026-07-28",
    "timezone": "Asia/Shanghai",
    "locale": "zh-CN"
  },

  "axes": {
    "x": {
      "field": "year",
      "label": "年份",
      "type": "linear",
      "domain": [2000, 2045],
      "tickInterval": 5,
      "gridLineStyle": "dashed",
      "gridLineColor": "#333a37"
    },
    "y": {
      "field": "valueTWh",
      "label": "电力需求 (TWh)",
      "type": "linear",
      "domain": [10000, 55000],
      "tickInterval": 5000,
      "gridLineStyle": "solid",
      "gridLineColor": "#333a37",
      "formatPrefix": ""
    }
  },

