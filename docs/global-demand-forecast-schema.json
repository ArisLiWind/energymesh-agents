  "interaction": {
    "zoom": {
      "enabled": true,
      "mode": "node-click",
      "description": "点击折线节点触发放大，显示该年份前后的详细区间",
      "defaultRange": 10,
      "minRange": 3,
      "maxRange": 45,
      "snapToYear": true,
      "animationDurationMs": 400
    },
    "tooltip": {
      "enabled": true,
      "template": "{year}年: {valueTWh} TWh (年增长率: {growthRate})",
      "showConfidence": true,
      "showSource": true
    },
    "legend": {
      "position": "top-right",
      "interactive": true,
      "toggleSeries": true
    },
    "annotations": {
      "showKeyDrivers": true,
      "driverMarkerStyle": "vertical-dashed-line",
      "driverLabelPosition": "top"
    }
  },

  "visualConfig": {
    "chartType": "multiSeriesLine",
    "foregroundColor": "#edf3ee",
    "backgroundColor": "#111513",
    "panelBackground": "#202624",
    "fontFamily": "Inter, PingFang SC, Microsoft YaHei, sans-serif",
    "splitLine": {
      "enabled": true,
      "historicalAfter": 2025,
      "splitLabelLeft": "历史数据 (实线)",
      "splitLabelRight": "预测数据 (虚线)"
    },
    "responsiveness": {
      "breakpoints": {
        "desktop": { "minWidth": 1120, "fontSize": 12, "pointRadius": 4 },
        "tablet": { "minWidth": 768, "fontSize": 10, "pointRadius": 3 },
        "mobile": { "minWidth": 320, "fontSize": 9, "pointRadius": 2 }
      }
    }
  },

  "frontendIntegration": {
    "description": "前端渲染引擎的数据消费约定",
    "dataBinding": {
      "seriesField": "series[].data",
      "xField": "year",
      "yField": "valueTWh",
      "lineStyleField": "series[].lineStyle",
      "lineColorField": "series[].lineColor",
      "dashPatternField": "series[].dashPattern"
    },
    "nodeClickHandler": {
      "eventName": "node:click",
      "payload": {
        "seriesId": "string",
        "year": "number",
        "valueTWh": "number",
        "confidence": "string",
        "nearbyRange": "number[]"
      },
      "action": "zoomToRange"
    },
    "renderLibrary": "agnostic",
    "suggestedLibraries": ["ECharts", "D3.js", "Chart.js", "Observable Plot"],
    "svgFallback": false
  }
}
